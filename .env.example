# Copy this file to .env and keep it private. Never commit your real .env.
# Postgres bootstrap password used only to initialize the Compose database.
# Choose a strong value and keep it safe: changing it does not rotate an existing volume's password.
POSTGRES_BOOTSTRAP_PASSWORD=

# Use three distinct strong passwords (at least 32 randomly generated ASCII letters/digits).
# Keep the role password values and the passwords in the corresponding URLs identical.
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
DATABASE_URL=postgresql://eclipse_app:REPLACE_ME@postgres:5432/eclipse
MIGRATION_DATABASE_URL=postgresql://eclipse_migrator:REPLACE_ME@postgres:5432/eclipse

# Optional TASK-007/008 host-only developer probes. Never passed to Compose services.
# Prefer setting this privately in .env.local; never paste a real key into chat.
MODEL_API_KEY=

# Internal service credential for the desktop controller (64 hex chars). Run: npm run desktop:secret
DESKTOP_CONTROL_SECRET=

# Master key for server-side encryption of saved credentials (64 lowercase hex chars). Run: npm run encryption-key
# Preserve this value with backups: changing it makes existing encrypted data unreadable.
ENCRYPTION_KEY=

# Canonical browser origin (exact scheme + host + port; no trailing slash).
# Use the public HTTPS origin for a separately configured TLS deployment.
# Disposable test stacks on another port must explicitly override this value.
APP_ORIGIN=http://127.0.0.1:3000

# Largest file the owner can attach in chat, in MB (whole number, 1 to 1024). Empty means 250.
MAX_UPLOAD_MB=
# Internal service credential between app and egress-proxy (64 hex chars). Run: npm run egress:secret
EGRESS_PROXY_SECRET=
# Internal credential between the desktop supervisor and egress-proxy for per-agent browser egress. Run: npm run egress:secret
EGRESS_DESKTOP_SECRET=

# TASK-088. Public client ID of your GitHub App for "Connect GitHub" (not a secret). Enable device flow and token
# expiration in the app's settings. Self-hosters can register their own app and change this value.
GITHUB_APP_CLIENT_ID=
# Public GitHub App slug, used for the install link (github.com/apps/<slug>/installations/new).
GITHUB_APP_SLUG=eclipse-crew

# Seed of the Ed25519 key that signs proof receipts (64 lowercase hex chars). Run: npm run receipt-key
# Without it agents refuse to run. Back it up: a new key changes your pinned fingerprint (old runs still verify).
RECEIPT_SIGNING_KEY=

# TASK-085. Set false to stop the 3-minute stalled-run sweeper; heartbeats still run.
RUN_SWEEPER_ENABLED=true

# Heavy evidence bytes (screenshots, checkpoints, teach captures) are kept for
# 32 days after their last use, then auto-deleted. Receipts are never purged.
# At this byte cap, the daily sweep first deletes evidence unused for 7 days.
ARTIFACTS_CAP_BYTES=20000000000
