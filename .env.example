# Copy this file to .env and keep it private. Never commit your real .env.
# Postgres bootstrap password used only to initialize the Compose database.
# Choose a strong value and keep it safe: changing it does not rotate an existing volume's password.
POSTGRES_BOOTSTRAP_PASSWORD=

# Use three distinct strong passwords (at least 32 randomly generated ASCII letters/digits).
# Keep the role password values and the passwords in the corresponding URLs identical.
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
DATABASE_URL=postgresql://eclipse_app:REPLACE_ME@postgres:5432/eclipse
MIGRATION_DATABASE_URL=postgresql://eclipse_migrator:REPLACE_ME@postgres:5432/eclipse

# Optional TASK-007/008 host-only developer probes. Never passed to Compose services.
# Prefer setting this privately in .env.local; never paste a real key into chat.
MODEL_API_KEY=

# Internal service credential for the desktop controller (64 hex chars). Run: npm run desktop:secret
DESKTOP_CONTROL_SECRET=

# Canonical browser origin (exact scheme + host + port; no trailing slash).
# Use the public HTTPS origin for a separately configured TLS deployment.
# Disposable test stacks on another port must explicitly override this value.
APP_ORIGIN=http://127.0.0.1:3000
